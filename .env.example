# InsightForge BI — environment template
# Copy to .env and adjust. Never commit .env with real secrets.

# --- Database ---
# Docker Compose (Postgres):
DATABASE_URL=postgresql+psycopg2://insightforge:insightforge_pw@postgres:5432/insightforge
# Local dev without Docker (SQLite fallback):
# DATABASE_URL=sqlite:///./insightforge.db
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=insightforge_pw
POSTGRES_DB=insightforge

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
